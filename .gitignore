node_modules/
dist/
release/
build/icon.iconset/
.DS_Store

# iOS build products — the Xcode project itself IS tracked
apps/ios/ios/App/App/public/
apps/ios/ios/DerivedData/

# local dev conveniences
.claude/
.gstack/

# Radiant keeps its secrets in ~/.radiant and the Keychain, so there is no .env
# today — but this is a public repo, and the day someone adds one it must not be
# the commit that publishes it.
.env
.env.*
!.env.example

# harness benchmark (scripts/bench-harness.mjs): environments, checkouts and
# traces are rebuilt; the plan, the gold check and the report are kept
bench/.venv/
bench/repos/
bench/work/
bench/envs/
bench/tmp/
bench/bin/
bench/logs/
bench/data/swe-bench-lite.json
bench/results/*/*__r*.json
bench/results/*/preds-r*.jsonl

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
